# Copy to a private file (for example ~/.config/contextflow/contextflow.env),
# set the real values, then source it before starting the router. Never commit it.

# Optional: only needed for Windows + Git Bash, where python3 is not on PATH.
# export CONTEXTFLOW_PYTHON="/c/Users/<user>/path/to/python.exe"
# Optional: forces MTClaw's wrapper subprocess to use Git Bash instead of WSL.
# export CONTEXTFLOW_BASH_BIN="D:/Javaee/Git/bin/bash.exe"
# Optional: ContextFlow defaults to 1 so its 18 vertical tools are the only
# Router tools. Set 0 only when generic MTClaw builtins are explicitly wanted.
# export CONTEXTFLOW_DISABLE_BUILTIN_TOOLS="1"

# OpenAI-compatible model used by MTClaw to decide whether a ContextFlow tool fits.
export CONTEXTFLOW_ROUTING_BASE_URL="https://your-routing-endpoint/v1"
export CONTEXTFLOW_ROUTING_MODEL="your-tool-calling-model"
export CONTEXTFLOW_ROUTING_API_KEY="replace-with-routing-key"

# OpenAI-compatible upstream model used for requests that do not match a tool,
# or when Function Router's completion check hands the conversation upstream.
export CONTEXTFLOW_UPSTREAM_BASE_URL="https://your-upstream-endpoint/v1"
export CONTEXTFLOW_UPSTREAM_MODEL="your-upstream-model"
export CONTEXTFLOW_UPSTREAM_API_KEY="replace-with-upstream-key"
